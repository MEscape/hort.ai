# Docker Compose interpolation values for the local dependencies (docker-compose.yml).
# Copy to .env.docker and pass it explicitly: `docker compose --env-file .env.docker ...`.
# These are development defaults, not production credentials.
# Values marked "= .env" must stay identical to the application's `.env`.

TZ=UTC
PGTZ=UTC

# PostgreSQL. User, password and database = DATABASE_URL in .env;
# AUTH_DATABASE_NAME = the database in AUTH_DATABASE_URL.
POSTGRES_USER=hortai
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hortai
AUTH_DATABASE_NAME=hortai_auth

# Redis REST emulator (Upstash-compatible). SRH_TOKEN = UPSTASH_REDIS_REST_TOKEN in .env.
SRH_MODE=env
SRH_TOKEN=local-dev-redis-token
SRH_CONNECTION_STRING=redis://redis:6379

# Azurite (Microsoft's published emulator credentials). = STORAGE_AZURE_* in .env.
STORAGE_AZURE_ACCOUNT_NAME=devstoreaccount1
STORAGE_AZURE_ACCOUNT_KEY=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==
STORAGE_AZURE_PUBLIC_CONTAINER=hortai-public
STORAGE_AZURE_PRIVATE_CONTAINER=hortai-private
# Browser origin allowed to upload to Azurite (CORS). = NEXT_PUBLIC_APP_URL in .env.
DOCKER_APP_ORIGIN=http://localhost:3000
