{
  "name": "hortai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "build:vercel": "npm run typecheck && npm run lint && npm run format:check && npm run i18n:check && npm run dead-code && npm run test:coverage && npm run test:architecture && npm run test:scripts && npm run db:generate && npm run db:migrate:check && npm run build && npm run db:migrate && npm run db:verify",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run i18n:check && npm run dead-code && npm run test:integration && npm run test:coverage && npm run test:architecture && npm run test:scripts",
    "test": "vitest run __tests__/src",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run __tests__/src --coverage",
    "test:watch": "vitest",
    "test:architecture": "vitest run __tests__/architecture __tests__/eslint",
    "test:scripts": "vitest run __tests__/scripts",
    "db:generate": "prisma contract emit",
    "db:migrate:check": "prisma migration check",
    "db:migrate:app": "prisma db migrate",
    "db:migrate:status": "prisma migration status",
    "db:migrate:auth": "tsx migrations/apply-auth-migration.ts",
    "db:migrate": "npm run db:migrate:app && npm run db:migrate:auth",
    "db:verify": "prisma db verify --strict",
    "db:seed": "tsx --conditions=react-server prisma/seed.ts",
    "db:studio": "prisma studio",
    "i18n:check": "vitest run __tests__/architecture/i18n-catalogs.test.ts",
    "gen": "tsx scripts/gen.ts",
    "brand:generate": "tsx scripts/generate-brand-assets.ts",
    "dead-code": "tsx scripts/dead-code.ts",
    "tutors:sync": "tsx scripts/sync-tutors.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@prisma/orm-family-sql": "8.0.0-rc.19",
    "@prisma/orm-postgres": "8.0.0-rc.19",
    "better-auth": "^1.7.12",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "dotenv": "^18.0.8",
    "lucide-react": "^1.61.0",
    "neverthrow": "^8.2.0",
    "next": "^16.4.2",
    "next-intl": "^4.14.9",
    "nodemailer": "^10.2.0",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "server-only": "^0.0.1",
    "temporal-polyfill": "1.0.6",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.4.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "8.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "prisma": "8.0.0-rc.25",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "prisma": "$prisma",
    "@prisma/dev": {
      "valibot": "^1.5.0",
      "@hono/node-server": "^1.19.15",
      "hono": "^4.13.5",
      "lodash": "^4.18.0"
    }
  }
}
