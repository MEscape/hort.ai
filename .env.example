# ==============================================================================
# HORTAI - APPLICATION ENVIRONMENT TEMPLATE
# Copy to `.env` and adjust. `.env` is local and must never be committed; this
# file holds placeholders only and is safe to commit.
#
# Validated at startup, so a bad or missing value stops the app with a message
# naming the variable: `@lib/config` (NEXT_PUBLIC_*, safe for the browser) and
# `@lib/config/server` (everything else, secrets included).
#
# Reading this file:
#   NAME=value     set; the value works for local development
#   # NAME=value   optional; the value shown is the default unless noted
#   # NAME=<...>   no default; replace the <placeholder> to use the setting
#
# Rules:
#   - Leave an optional variable commented out rather than blank (`NAME=`).
#   - Flags are exactly `true` or `false`, lower case. Lists are comma-separated.
#   - Quote values containing spaces or `<>`.
#   - Production values belong in the host's secret store, not in a file.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Runtime
# ------------------------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
# Days the audit trail keeps an entry.
# AUDIT_RETENTION_DAYS=365

# ------------------------------------------------------------------------------
# 2. Database (Required)
# ------------------------------------------------------------------------------
# Keep user, password and database name aligned with POSTGRES_* in `.env.docker`.
DATABASE_URL=postgresql://hortai:change-me@localhost:5432/hortai
DATABASE_POOL_SIZE=10
DATABASE_POOL_TIMEOUT_SECONDS=10

# ------------------------------------------------------------------------------
# 3. Authentication
# ------------------------------------------------------------------------------
# `false` skips sign-in and acts as a fixed parent of the default tenant. Refused in production.
AUTH_ENABLED=false
# The one tenant every account belongs to: lower-case letters, digits and hyphens. Never chosen by a request.
# AUTH_DEFAULT_TENANT_ID=default
# Required when AUTH_ENABLED=true. Generate with: openssl rand -base64 48
# AUTH_SECRET=<random-secret-of-at-least-32-characters>
# AUTH_DATABASE_URL=postgresql://hortai:change-me@localhost:5432/hortai_auth
# AUTH_TRUSTED_PROXIES=10.0.0.0/8,192.168.0.0/16
# Comma-separated. Confirmed accounts with these addresses become platform admins (all learner permissions on any parent's data, audited).
# AUTH_PLATFORM_ADMIN_EMAILS=admin@example.org

# Optional session overrides (defaults are defined by the application)
# AUTH_SESSION_EXPIRES_IN_SECONDS=604800
# AUTH_SESSION_UPDATE_AGE_SECONDS=86400
# AUTH_SESSION_FRESH_AGE_SECONDS=900
# AUTH_SESSION_MAX_LIFETIME_SECONDS=2592000
# AUTH_DATABASE_POOL_SIZE=5

# ------------------------------------------------------------------------------
# 4. Mail
# ------------------------------------------------------------------------------
# none | smtp | resend (resend only in production)
MAIL_PROVIDER=smtp
MAIL_FROM="Hort.ai <no-reply@hortai.local>"
MAIL_SMTP_HOST=localhost
MAIL_SMTP_PORT=1025
# MAIL_SMTP_SECURE=false
# MAIL_SMTP_USER=<smtp-username>
# MAIL_SMTP_PASSWORD=<smtp-password>
# MAIL_API_KEY=<resend-api-key>
# MAIL_API_URL=https://api.resend.com/emails

# ------------------------------------------------------------------------------
# 5. Rate limiting
# ------------------------------------------------------------------------------
# Locally `docker compose up` runs an Upstash-compatible emulator.
# `false` counts nothing and allows every attempt, and then the settings below are not needed.
# Refused in production.
# RATE_LIMIT_ENABLED=true
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=local-dev-redis-token
RATE_LIMIT_SECRET=local-dev-rate-limit-secret-0000000000
# RATE_LIMIT_CLIENT_ADDRESS_SOURCE=proxies
# RATE_LIMIT_TIMEOUT_MS=1500

# ------------------------------------------------------------------------------
# 6. Object storage
# ------------------------------------------------------------------------------
# none | azure. Locally `docker compose up` runs the Azurite emulator.
STORAGE_PROVIDER=azure
STORAGE_AZURE_ACCOUNT_NAME=devstoreaccount1
STORAGE_AZURE_ACCOUNT_KEY=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==
STORAGE_AZURE_BLOB_ENDPOINT=http://127.0.0.1:10000/devstoreaccount1
STORAGE_AZURE_PUBLIC_CONTAINER=hortai-public
STORAGE_AZURE_PRIVATE_CONTAINER=hortai-private
STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:10000/devstoreaccount1/hortai-public

# Alexa skill id (Developer Console → Endpoint). Unset: POST /api/alexa answers 503.
# ALEXA_SKILL_ID=amzn1.ask.skill.00000000-0000-0000-0000-000000000000
# Tutor voice on Alexa (needs ELEVENLABS_API_KEY and STORAGE_AZURE_PRIVATE_CONTAINER, else Alexa's own voice).
# ALEXA_TUTOR_VOICE=true
# ALEXA_TUTOR_ID=max

# ------------------------------------------------------------------------------
# 7. Speech (ElevenLabs: tutor voices and the child's speech-to-text)
# ------------------------------------------------------------------------------
# Unset turns speech off: the app starts and stays usable with text. Server-only secret.
# ELEVENLABS_API_KEY=<elevenlabs-api-key>
# ELEVENLABS_API_URL=https://api.elevenlabs.io
# ELEVENLABS_TTS_MODEL_ID=eleven_multilingual_v2
# ELEVENLABS_STT_MODEL_ID=scribe_v1
# ELEVENLABS_TIMEOUT_MS=20000

# ------------------------------------------------------------------------------
# 8. AI companion (Gemini API: hints and answer feedback)
# ------------------------------------------------------------------------------
# For the hackathon demo only; re-assess the provider before any test with children. Without a key
# the AI is off and hints use the predefined prompts. Key from https://aistudio.google.com/apikey.
# GEMINI_API_KEY=<gemini-api-key>
# GEMINI_API_URL=https://generativelanguage.googleapis.com
# GEMINI_MODEL_ID=gemini-3.8-flash
# GEMINI_TIMEOUT_MS=8000
# Second safety check of every AI text with TypeSafe's Jev (https://console.typesafe.ai/keys).
# Required in production whenever GEMINI_API_KEY is set; optional in development.
# TYPESAFE_API_KEY=<typesafe-api-key>
# TYPESAFE_API_URL=https://api.typesafe.ai
# TYPESAFE_MODEL_ID=jev-1.14.0
# TYPESAFE_TIMEOUT_MS=3000

# Encrypts classroom invite codes at rest so teachers can see them again (AES-256-GCM).
# 32 random bytes, base64: `openssl rand -base64 32`. Unset: codes are stored as a hash only.
# CLASSROOM_INVITE_CODE_KEY=

# ------------------------------------------------------------------------------
# 9. Public (browser-safe, never a secret)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
